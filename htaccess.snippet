# Generated by src/build.js. Merge into the site root .htaccess (Apache / LiteSpeed shared hosting).
RewriteEngine On
# Force HTTPS and the canonical non-www host
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://pixelbrahma.com%{REQUEST_URI} [L,R=301]
# Old /?p=123 post IDs
RewriteCond %{QUERY_STRING} (^|&)p=\d+ [NC]
RewriteRule ^$ /? [L,R=301]
RedirectMatch 301 ^/app-web-development/?$ /app-development/
RedirectMatch 301 ^/digital-media/?$ /digital-marketing/
RedirectMatch 301 ^/app/?$ /app-development/
RedirectMatch 301 ^/vehicle-branding/?$ /outdoor/
RedirectMatch 301 ^/home/?$ /
RedirectMatch 301 ^/home-final/?$ /
RedirectMatch 301 ^/new-home/?$ /
RedirectMatch 301 ^/dummy/?$ /
RedirectMatch 301 ^/sample-page/?$ /
RedirectMatch 301 ^/wri/?$ /app-development/
RedirectMatch 301 ^/pixcam/?$ /app-development/
RedirectMatch 301 ^/uniwood-products/?$ /app-development/
RedirectMatch 301 ^/amd-retail-connect/?$ /app-development/
RedirectMatch 301 ^/shop/?$ /
RedirectMatch 301 ^/cart/?$ /
RedirectMatch 301 ^/checkout/?$ /
RedirectMatch 301 ^/my-account/?$ /
RedirectMatch 301 ^/feed/?$ /
RedirectMatch 301 ^/wp-admin/?$ /
RedirectMatch 301 ^/wp-login.php/?$ /
RedirectMatch 301 ^/xmlrpc.php/?$ /
RedirectMatch 301 ^/author(/.*)?$ /
RedirectMatch 301 ^/category(/.*)?$ /
RedirectMatch 301 ^/tag(/.*)?$ /
RedirectMatch 301 ^/feed(/.*)?$ /
RedirectMatch 301 ^/comments/feed(/.*)?$ /
RedirectMatch 301 ^/wp-admin(/.*)?$ /
RedirectMatch 301 ^/wp-content(/.*)?$ /
RedirectMatch 301 ^/wp-includes(/.*)?$ /
RedirectMatch 301 ^/wp-json(/.*)?$ /
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' https://www.googletagmanager.com; style-src 'self' 'sha256-YwZ7gq9Idyn06YpD3N5G8Tgxj+yMbTa8RZGbt6xzRpI='; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://www.google.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
</IfModule>
